# DivaBot configuration — copy to .env and fill in.
# All variables are optional; the defaults shown in the comments apply.

# --- LLM provider -----------------------------------------------------------
# "local" (llama.cpp server) or "deepseek" (API).
LLM_PROVIDER=deepseek

# DeepSeek API (used when LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# Local llama.cpp server (used when LLM_PROVIDER=local)
# LLAMA_API_URL=http://localhost:8080/v1
# LLAMA_MODEL=llama-3-8b

# Shared LLM tuning (both providers)
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2
# DIVA_SYSTEM_PROMPT=You are Diva, a helpful and witty assistant. Keep answers concise.

# --- Discord ----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# --- WhatsApp ---------------------------------------------------------------
# Bridge URL (see scripts/run_whatsapp_bridge.sh) and gating.
# WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
# WHATSAPP_POLL_INTERVAL=1.0
# WHATSAPP_ALLOWED_USERS=5491158432267,15551234567
